{
  "manifest_version": 3,
  "name": "Codeforces Markdown Copy",
  "version": "1.0.0",
  "description": "一键将 Codeforces 题目转换为 Markdown 并复制到剪贴板",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/contest/*/problem/*",
        "*://codeforces.com/problemset/problem/*/*",
        "*://codeforces.com/gym/*/problem/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}